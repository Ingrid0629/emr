        insuranceCard: "Nơi lưu thẻ bảo hiểm y tế / du lịch", vaccineCard: "Nơi lưu chứng nhận tiêm chủng", medicalLetters: "Giấy chứng nhận / thư của bác sĩ", verifiedBy: "Người và ngày xác minh gần nhất",
        reviewDate: "Ngày xem lại tiếp theo", languageNotes: "Thuật ngữ y khoa / ghi chú dịch", verifyLabel: "Xác minh trước khi dùng:",
        verifiedNote: "Chỉ tên đã được xác nhận mới được điền sẵn. Hãy xác minh mọi thông tin cá nhân và y tế với cha mẹ hoặc người giám hộ và bác sĩ trước khi dùng.",
        disclaimerTitle: "Quan trọng:", footerDisclaimer: "Đây là bản tóm tắt y tế cá nhân để đi xa và giao tiếp khẩn cấp. Đây không phải hồ sơ chính thức của bệnh viện và không thay thế đánh giá của bác sĩ. Người dùng, cha mẹ / người giám hộ hợp pháp và nhân viên y tế có chuyên môn cần cùng xác minh trước khi dùng.",
        tapToEnter: "Chọn “Chỉnh sửa hồ sơ” để nhập", datePlaceholder: "Ngày: YYYY-MM-DD", listPlaceholder: "Mỗi dòng một mục; có thể thêm quan hệ, điện thoại hoặc ghi chú",
        structuredPlaceholder: "Mỗi dòng: tên | ngày chẩn đoán | tình trạng hiện tại | ghi chú", recordPlaceholder: "Mỗi dòng: ngày | sự kiện / thủ thuật | bệnh viện hoặc quốc gia | kết quả",
        medPlaceholder: "Mỗi dòng: thuốc | liều | đường dùng / tần suất | lý do | ngày bắt đầu hoặc ngừng", reactionPlaceholder: "Tác nhân | phản ứng | mức độ | ngày | xử trí",
        familyPlaceholder: "Mỗi dòng: quan hệ | bệnh | tuổi lúc chẩn đoán | ghi chú", vaccinePlaceholder: "Vắc-xin | mũi số | ngày | nơi tiêm", contactPlaceholder: "Tên / cơ sở | chuyên khoa hoặc quan hệ | điện thoại / email",
        editHint: "Chọn bất kỳ ô nào để nhập", editOn: "Đã bật chế độ chỉnh sửa", savedToast: "Đã lưu hồ sơ trên thiết bị này", cancelledToast: "Đã hủy thay đổi",
        privacyOn: "Đã bật che thông tin", privacyOff: "Thông tin đang hiển thị", emergencyOn: "Đang hiện tóm tắt khẩn cấp", emergencyOff: "Đang hiện toàn bộ hồ sơ",
        exportedToast: "Đã tải bản sao; hãy bảo quản an toàn", importConfirm: "Việc nhập sẽ thay thế hồ sơ đang lưu trên thiết bị này. Tiếp tục?", importedToast: "Đã nhập bản sao",
        importError: "Không thể đọc tệp sao lưu này", clearConfirm: "Xóa toàn bộ thông tin y tế đã lưu trên thiết bị này? Không thể hoàn tác."
      }
    };

    const STORAGE_KEY = "ingrid-medical-passport-v1";
    const languageTags = { zh: "zh-TW", en: "en", ja: "ja-JP", ko: "ko-KR", vi: "vi-VN" };
    const htmlLangs = { zh: "zh-Hant", en: "en", ja: "ja", ko: "ko", vi: "vi" };
    let language = localStorage.getItem(STORAGE_KEY + "-language") || "zh";
    let editMode = false;
    let privateMode = false;
    let emergencyMode = false;
    let toastTimer;
    let savedSnapshot = {};

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
    const t = (key) => (translations[language] && translations[language][key]) || (translations.en && translations.en[key]) || key;

    function getAllFields() {
      const fields = {};
      $$('[data-field]').forEach((element) => {
        const key = element.dataset.field;
        const value = (element.offsetParent === null ? element.textContent : element.innerText).trim();
        if (!(key in fields) || fields[key] === "") fields[key] = value;
      });
      return fields;
    }

    function setField(key, value, source) {
      $$(`[data-field="${CSS.escape(key)}"]`).forEach((element) => {
        if (element !== source) element.textContent = value || "";
      });
    }

    function applyFields(fields) {
      Object.entries(fields || {}).forEach(([key, value]) => setField(key, String(value ?? "")));
      updateAvatar();
      updateCompletion();
    }

    function loadRecord() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
        if (saved && saved.fields) {
          applyFields(saved.fields);
          updateDates(saved.updatedAt);
        } else {
          updateDates(null);
        }
      } catch (_) {
        updateDates(null);
      }
      savedSnapshot = getAllFields();
    }

    function saveRecord(showMessage = true) {
      const payload = { version: 1, updatedAt: new Date().toISOString(), fields: getAllFields() };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      savedSnapshot = { ...payload.fields };
      updateDates(payload.updatedAt);
      updateCompletion();
      if (showMessage) showToast(t("savedToast"));
    }

    function setLanguage(nextLanguage) {
      language = translations[nextLanguage] ? nextLanguage : "zh";
      localStorage.setItem(STORAGE_KEY + "-language", language);
      document.documentElement.lang = htmlLangs[language];
      document.title = t("pageTitle");
      $("#languageSelect").value = language;
      $$('[data-i18n]').forEach((element) => { element.textContent = t(element.dataset.i18n); });
      $$('[data-placeholder-key]').forEach((element) => { element.dataset.placeholder = t(element.dataset.placeholderKey); });
      $("#privacyButton").title = privateMode ? t("reveal") : t("privacy");
      $("#privacyButton").setAttribute("aria-label", $("#privacyButton").title);
      $("#emergencyButton").title = emergencyMode ? t("fullRecord") : t("emergencyMode");
      $("#emergencyButton").setAttribute("aria-label", $("#emergencyButton").title);
      updateConnection();
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
        updateDates(saved && saved.updatedAt);
      } catch (_) {
        updateDates(null);
      }
      updateCompletion();
      updateEditButton();
    }

    function updateDates(iso) {
      if (!iso) {
        $("#lastUpdatedText").textContent = t("notSaved");
        $("#heroUpdated").textContent = "—";
        return;
      }
      try {
        const formatted = new Intl.DateTimeFormat(languageTags[language], { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }).format(new Date(iso));
        $("#lastUpdatedText").textContent = formatted;
        $("#heroUpdated").textContent = formatted;
      } catch (_) {
        $("#lastUpdatedText").textContent = iso.slice(0, 10);
        $("#heroUpdated").textContent = iso.slice(0, 10);
      }
    }

    function updateCompletion() {
      const fields = getAllFields();
      const entries = Object.entries(fields).filter(([key]) => !["preferredName", "legalNameZh", "legalNameEn", "primaryLanguage"].includes(key));
      const filled = entries.filter(([, value]) => value.trim()).length;
      const total = entries.length;
      const percent = total ? Math.round((filled / total) * 100) : 0;
      $("#completionPercent").textContent = percent + "%";
      $("#completionCount").textContent = `${filled} / ${total} ${t("fields")}`;
      $("#progressFill").style.width = percent + "%";
    }

    function updateAvatar() {
      const name = ($('[data-field="legalNameZh"]') || {}).innerText || "惠";
      $("#avatar").textContent = name.trim().slice(-1) || "惠";
    }

    function updateConnection() {
      $("#connectionText").textContent = navigator.onLine ? t("deviceReady") : t("offlineReady");
    }

    function setEditing(enabled) {
      editMode = enabled;
      document.body.classList.toggle("editing", editMode);
      $$('[data-field]').forEach((element) => {
        element.contentEditable = editMode ? "true" : "false";
        element.spellcheck = editMode;
      });
      updateEditButton();
      if (editMode) {
        savedSnapshot = getAllFields();
        showToast(t("editOn"));
      }
    }

    function updateEditButton() {
      const label = $("#editButton [data-i18n]");
      if (label) label.textContent = editMode ? t("done") : t("edit");
    }

    function setPrivacy(enabled) {
      privateMode = enabled;
      document.body.classList.toggle("private-mode", enabled);
      $("#privacyButton").textContent = enabled ? "◎" : "◉";
      $("#privacyButton").title = enabled ? t("reveal") : t("privacy");
      $("#privacyButton").setAttribute("aria-label", $("#privacyButton").title);
      showToast(enabled ? t("privacyOn") : t("privacyOff"));
    }

    function setEmergency(enabled) {
      emergencyMode = enabled;
      document.body.classList.toggle("emergency-mode", enabled);
      $("#emergencyButton").textContent = enabled ? "▤" : "✚";
      $("#emergencyButton").title = enabled ? t("fullRecord") : t("emergencyMode");
      $("#emergencyButton").setAttribute("aria-label", $("#emergencyButton").title);
      if (enabled) window.scrollTo({ top: 0, behavior: "smooth" });
      showToast(enabled ? t("emergencyOn") : t("emergencyOff"));
    }

    function showToast(message) {
      const toast = $("#toast");
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 2800);
    }

    function exportRecord() {
      const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
      const payload = stored || { version: 1, updatedAt: new Date().toISOString(), fields: getAllFields() };
      payload.format = "Ingrid Multilingual Medical Passport";
      payload.exportedAt = new Date().toISOString();
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `Ingrid_Medical_Passport_${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      showToast(t("exportedToast"));
    }

    async function importRecord(file) {
      try {
        const data = JSON.parse(await file.text());
        if (!data || typeof data.fields !== "object") throw new Error("Invalid file");
        if (!window.confirm(t("importConfirm"))) return;
        const payload = { version: 1, updatedAt: new Date().toISOString(), fields: data.fields };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
        applyFields(payload.fields);
        updateDates(payload.updatedAt);
        savedSnapshot = getAllFields();
        showToast(t("importedToast"));
      } catch (_) {
        showToast(t("importError"));
      }
    }

    function clearRecord() {
      if (!window.confirm(t("clearConfirm"))) return;
      localStorage.removeItem(STORAGE_KEY);
      window.location.reload();
    }

    $$('[data-field]').forEach((element) => {
      element.addEventListener("input", () => {
        setField(element.dataset.field, element.innerText, element);
        updateAvatar();
        updateCompletion();
      });
      element.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "s") {
          event.preventDefault(); saveRecord(); setEditing(false);
        }
      });
    });

    $("#languageSelect").addEventListener("change", (event) => setLanguage(event.target.value));
    $("#editButton").addEventListener("click", () => editMode ? (saveRecord(), setEditing(false)) : setEditing(true));
    $("#saveButton").addEventListener("click", () => { saveRecord(); setEditing(false); });
    $("#cancelEditButton").addEventListener("click", () => { applyFields(savedSnapshot); setEditing(false); showToast(t("cancelledToast")); });
    $("#privacyButton").addEventListener("click", () => setPrivacy(!privateMode));
    $("#emergencyButton").addEventListener("click", () => setEmergency(!emergencyMode));
    $("#printButton").addEventListener("click", () => window.print());
    $("#exportButton").addEventListener("click", exportRecord);
    $("#importButton").addEventListener("click", () => $("#importFile").click());
    $("#importFile").addEventListener("change", (event) => { if (event.target.files[0]) importRecord(event.target.files[0]); event.target.value = ""; });
    $("#clearButton").addEventListener("click", clearRecord);
    window.addEventListener("online", updateConnection);
    window.addEventListener("offline", updateConnection);

    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      $$('.nav-link').forEach((link) => link.classList.toggle("active", link.getAttribute("href") === `#${visible.target.id}`));
    }, { rootMargin: "-18% 0px -68% 0px", threshold: [0, .2, .5] });
    $$('.record-section').forEach((section) => observer.observe(section));

    setLanguage(language);
    loadRecord();
    updateAvatar();
    updateConnection();
  </script>
</body>
